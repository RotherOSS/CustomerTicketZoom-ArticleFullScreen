<?xml version="1.0" encoding="utf-8" ?>
<otobo_package version="0.1">
    <Name>CustomerTicketZoom-ArticleFullScreen</Name>
    <Version>0.0.0</Version>
    <Framework>11.1.x</Framework>
    <Vendor>Rother OSS GmbH</Vendor>
    <URL>https://otobo.io/</URL>
    <License>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</License>
    <Description Lang="en">Adds full screen view for articles in the zoom view of the customer interface.</Description>
    <Description Lang="de">Fügt eine Vollbildansicht für Artikel in der Detailansicht des Kunden Interface hinzu.</Description>
    <Description Lang="hu">Teljes képernyős nézetet ad az ügyfélfelület nagyítási nézetében lévő bejegyzésekhez.</Description>
    <Filelist>
        <File Permission="660" Location="var/httpd/htdocs/skins/Customer/default/css/Core.TicketZoom.css" />
        <File Permission="660" Location="var/httpd/htdocs/js/Core.Customer.TicketZoom.js" />
    </Filelist>
</otobo_package>
